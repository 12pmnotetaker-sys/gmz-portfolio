---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { company, licenseShort, serviceRegionInline } from '@data/site';
import apld from '@/assets/brand/apld-logo.webp';
import magnolia from '@/assets/about/about-portrait-magnolia.webp';
import garden from '@/assets/about/about-portrait-garden.webp';
import ranunculus from '@/assets/about/about-ranunculus.webp';

const membership = company.memberships[0];

/**
 * The facts panel. Every value is read from src/data/site.ts so a correction
 * lands here, in the footer, in the contact panel and in the structured data
 * at the same time.
 */
const facts = [
  { k: 'Founded', v: String(company.founded) },
  { k: 'Licence', v: licenseShort },
  { k: 'Based', v: company.address.locality },
  { k: 'Serving', v: company.serviceRegion },
  { k: 'Hours', v: `${company.hours.daysShort}, ${company.hours.time}` },
  { k: 'Drawings', v: company.drawings },
  ...(membership ? [{ k: 'Member', v: membership.name }] : []),
];
---

<BaseLayout
  title="About"
  description={`${company.legalName} has been designing and building gardens on ${serviceRegionInline} since ${company.founded}, as a family business, licensed and insured throughout.`}
>
  <div class="about">
    <div class="about__side">
      <dl class="facts">
        {
          facts.map((fact) => (
            <div class="facts__row">
              <dt>{fact.k}</dt>
              <dd>{fact.v}</dd>
            </div>
          ))
        }
      </dl>

      {
        membership && (
          <Image
            class="about__apld"
            src={apld}
            alt={membership.name}
            widths={[166, 332]}
            sizes="166px"
          />
        )
      }
    </div>

    <div class="about__body">
      <h1 class="page-title about__title">More than 30 years on the ground.</h1>
      <div class="rule-accent rule-accent--short"></div>
      <p class="about__lede">
        {company.legalName} has been designing and building gardens on {serviceRegionInline} since {
          company.founded
        }, as a family business, licensed and insured throughout.
      </p>

      <div class="about__intro">
        <figure class="figure about__portrait">
          <Image
            src={magnolia}
            alt="Liliana, who does the design and drawings at GMZ Landscaping"
            widths={[260, 520]}
            sizes="260px"
          />
          <div class="rule-accent"></div>
          <figcaption class="about__caption">Liliana, design and drawings.</figcaption>
        </figure>

        <p class="about__bio">
          Since childhood, Liliana has been immersed in gardening and landscaping, growing up around
          the landscaping trade at home. She spent her youth actively supporting various operations
          at {company.legalName}. Her enthusiasm for outdoor spaces is reflected in her work, from
          creating hand-drawn designs to developing comprehensive 3-D plans, demonstrating a strong
          commitment to her clients.
        </p>
      </div>

      <div class="about__grid">
        <figure class="figure">
          <Image
            class="about__shot about__shot--garden"
            src={garden}
            alt="A garden in flower, with zinnias, hollyhocks and sunflowers along a gravel path"
            widths={[320, 520, 800]}
            sizes="(width >= 900px) 320px, 45vw"
            loading="lazy"
          />
          <div class="rule-accent"></div>
          <figcaption class="about__caption">
            A garden in flower: zinnias, hollyhocks and sunflowers along a gravel path.
          </figcaption>
        </figure>

        <figure class="figure">
          <Image
            class="about__shot about__shot--ranunculus"
            src={ranunculus}
            alt="Rows of ranunculus in flower under shade frames"
            widths={[320, 520, 800]}
            sizes="(width >= 900px) 320px, 45vw"
            loading="lazy"
          />
          <div class="rule-accent"></div>
          <figcaption class="about__caption">
            Ranunculus in flower under the shade frames.
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 2.75rem var(--gutter) 0;
    display: flex;
    gap: var(--space-2xl);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .about__side {
    flex: 1 1 230px;
    min-width: 220px;
  }

  .about__apld {
    width: 166px;
    max-width: 100%;
    height: auto;
    margin-block-start: 1.625rem;
  }

  .about__body {
    flex: 999 1 520px;
    min-width: 300px;
  }

  .about__title {
    max-width: 22ch;
  }

  .about__lede {
    margin-block-start: var(--space-lg);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text);
    max-width: 56ch;
  }

  /* ---- Portrait and bio ------------------------------------------------ */

  .about__intro {
    display: flex;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
    margin-block-start: var(--space-lg);
  }

  .about__portrait {
    flex: 0 0 260px;
    max-width: 260px;
  }

  .about__portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Crops to the face rather than the middle of the frame. */
    object-position: 50% 8%;
    background: var(--gmz-well);
  }

  /*
   * The design centres this paragraph against the portrait beside it. The
   * prototype did that with a fixed pixel height and two leading line breaks;
   * this centres it with the flex row instead, which holds up at any width.
   */
  .about__bio {
    flex: 1 1 300px;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 48ch;
    text-align: center;
  }

  /* ---- Photo pair ------------------------------------------------------ */

  .about__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.75rem 1.5rem;
    margin-block-start: 2rem;
  }

  .about__shot {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--gmz-well);
  }

  .about__shot--garden {
    object-position: 50% 42%;
  }

  .about__shot--ranunculus {
    object-position: 50% 46%;
  }

  .about__caption {
    margin-block-start: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (width < 560px) {
    .about__bio {
      text-align: start;
    }
  }
</style>
