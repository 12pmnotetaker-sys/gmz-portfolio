---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { company } from '@data/site';
---

<BaseLayout
  title="About"
  description={`${company.legalName} is a licensed landscape contractor serving the San Francisco Peninsula.`}
>
  <PageHeader
    eyebrow="About"
    title={company.legalName}
    lede="A licensed landscape contractor working on the San Francisco Peninsula."
  />

  <div class="section">
    <div class="container layout">
      <div class="prose">
        {
          /*
           * PLACEHOLDER COPY. This page needs Xavier's own words about the
           * company's history, the crew and how GMZ works. Everything below
           * is a shape to fill, not approved copy. House style applies:
           * no em-dashes in body prose, no manufacturer names.
           */
        }
        <h2>Who we are</h2>
        <p>
          GMZ Landscaping is a licensed landscape contractor based in Redwood City, working across
          the San Francisco Peninsula. We design, build and maintain outdoor spaces for homeowners:
          patios and walls, planting and irrigation, fences and gates, and the standing weekly care
          that keeps a finished garden looking finished.
        </p>

        <h2>How we work</h2>
        <p>
          Most projects start with a site visit and a measured plan. Design resolves the expensive
          things first: grading, drainage, where you walk and what will still fit the space in ten
          years. Once the plan is settled we price it in detail, and what we build is what was
          drawn.
        </p>
        <p>
          Maintenance is its own service, with its own agreement and its own schedule. The same crew
          sees the same garden on the same day each week, which is what turns problems into small
          ones.
        </p>

        <h2>Where we work</h2>
        <p>We take projects in and around:</p>
        <ul class="areas">
          {company.serviceArea.map((area) => <li>{area}</li>)}
        </ul>
      </div>

      <aside class="credentials" aria-label="Credentials">
        <dl>
          <div>
            <dt>License</dt>
            <dd>{company.license.display}</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>{company.address.locality}, {company.address.region}</dd>
          </div>
          <div>
            <dt>Services</dt>
            <dd>{company.tagline}</dd>
          </div>
        </dl>
        <p class="credentials__cta"><a href="/contact">Get in touch</a></p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      align-items: start;
    }
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  .areas li {
    padding: 0.15em 0.7em;
    border-radius: 999px;
    background: var(--color-bg-tint);
    color: var(--color-accent-hover);
  }

  .credentials {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    font-size: var(--text-sm);
  }

  .credentials dl {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }

  .credentials dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .credentials dd {
    margin: 0;
    margin-block-start: var(--space-2xs);
  }

  .credentials__cta {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    font-weight: 600;
  }
</style>
