---
import { getEntries } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import {
  getServices,
  SERVICE_LINE_LABELS,
  labelFor,
  type Project,
  type Service,
} from '@data/content';
import { primaryPhone } from '@data/site';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { title, summary, serviceLine, highlights, relatedProjects, seo } = service.data;

const { Content } = await render(service);

/**
 * Related projects are resolved through the reference, then re-filtered:
 * a project marked draft must not surface here just because a service
 * happens to link to it.
 */
const linked: Project[] = relatedProjects.length ? await getEntries(relatedProjects) : [];
const projects = linked.filter(
  (project) => project && (import.meta.env.DEV || !project.data.draft),
);
---

<BaseLayout
  title={seo.title ?? title}
  description={seo.description ?? summary}
  noindex={seo.noindex}
>
  <PageHeader eyebrow={labelFor(SERVICE_LINE_LABELS, serviceLine)} title={title} lede={summary} />

  <div class="section">
    <div class="container layout">
      <div class="prose">
        <Content />
      </div>

      {
        highlights.length > 0 && (
          <aside class="highlights" aria-label={`What ${title.toLowerCase()} includes`}>
            <h2 class="highlights__heading">What it includes</h2>
            <ul>
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="highlights__cta">
              <a href="/contact">Ask about {title.toLowerCase()}</a>
              <span class="highlights__phone">
                or call <a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
              </span>
            </p>
          </aside>
        )
      }
    </div>
  </div>

  {
    projects.length > 0 && (
      <section class="section section--tint" aria-labelledby="examples-heading">
        <div class="container">
          <h2 id="examples-heading">Projects</h2>
          <div class="examples">
            <ProjectGrid {projects} />
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .highlights {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    font-size: var(--text-sm);
  }

  .highlights__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-sm);
  }

  .highlights ul {
    display: grid;
    gap: var(--space-xs);
  }

  .highlights__cta {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    font-weight: 600;
  }

  .highlights__phone {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .section--tint {
    background: var(--color-bg-subtle);
  }

  .examples {
    margin-block-start: var(--space-lg);
  }
</style>
