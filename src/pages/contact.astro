---
import BaseLayout from '@layouts/BaseLayout.astro';
import { formEndpoint } from '@data/portfolio';
import {
  company,
  fees,
  licenseShort,
  primaryPhone,
  secondaryPhone,
  serviceRegionInline,
} from '@data/site';

/**
 * The consultation request.
 *
 * The phone number is the primary call to action, as the design has it, and
 * the form is the fallback for anyone who would rather write. It posts to
 * Netlify Forms, which picks the form up from `data-netlify` at deploy time.
 * Set PUBLIC_CONTACT_ENDPOINT to post somewhere else instead.
 *
 * The inline thank-you panel is progressive enhancement. With JavaScript off
 * the form posts normally and the host shows its own confirmation.
 */
const action = formEndpoint || '/contact';
---

<BaseLayout
  title="Contact"
  description={`Call ${company.legalName} to book a consultation. ${company.hours.days}, ${company.hours.time}.`}
>
  <div class="contact">
    <div class="contact__main">
      <h1 class="page-title contact__title">Call and we'll set a time.</h1>

      <a class="contact__phone" href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>

      <p class="contact__alt">
        Or call <a href={`tel:${secondaryPhone.tel}`}>{secondaryPhone.display}</a>
      </p>

      <p class="contact__note">
        A consultation is {fees.consultation.display} for {fees.consultation.covers}, paid when you
        book. We walk the property, listen to what you want from it, and tell you honestly what it
        will take. No drawings and no quote at that stage, and nothing is credited against later
        work.
      </p>

      <form
        class="form"
        name="consultation"
        method="POST"
        {action}
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-consult-form
      >
        {/* Netlify needs the form name in the body when the post comes from fetch. */}
        <input type="hidden" name="form-name" value="consultation" />
        {/* Spam trap. A person never sees this, so a filled value is a bot. */}
        <p class="visually-hidden">
          <label>Leave this empty <input name="bot-field" tabindex="-1" /></label>
        </p>

        <div class="form__fields">
          <label class="field">
            <span class="field__label">Your name</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>

          <label class="field">
            <span class="field__label">Phone</span>
            <input name="phone" type="tel" autocomplete="tel" required />
          </label>

          <label class="field">
            <span class="field__label">Where is the property?</span>
            <input
              name="where"
              type="text"
              placeholder="Street and city"
              autocomplete="street-address"
            />
          </label>

          <label class="field">
            <span class="field__label">What are you hoping to do?</span>
            <textarea name="notes" rows="4"></textarea>
          </label>

          <button class="form__submit" type="submit">Request a consultation</button>
        </div>
      </form>

      <div class="sent" hidden data-consult-sent>
        <p class="kicker">Request received</p>
        <h2 class="sent__title">
          Thanks, <span data-consult-name>there</span>, we'll call you back.
        </h2>
        <p class="sent__note">
          Someone from the office will be in touch within one business day, {company.hours.days} between
          {' '}{company.hours.time}.
        </p>
        <button type="button" class="link-accent sent__again" data-consult-again>
          Send another
        </button>
      </div>

      <p class="failed" hidden data-consult-failed>
        That did not send. Please call <a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a
        >
        {' '}instead, or email <a href={`mailto:${company.email}`}>{company.email}</a>.
      </p>
    </div>

    <div class="contact__side">
      <dl class="facts">
        <div class="facts__row">
          <dt>Hours</dt>
          <dd>{company.hours.days}<br />{company.hours.time}</dd>
        </div>
        <div class="facts__row">
          <dt>Email</dt>
          <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </div>
        <div class="facts__row">
          <dt>Post</dt>
          <dd>
            {
              company.address.mailingLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))
            }
          </dd>
        </div>
        <div class="facts__row">
          <dt>Licence</dt>
          <dd>{licenseShort}</dd>
        </div>
        <div class="facts__row">
          <dt>Area served</dt>
          <dd>{company.address.locality} and {serviceRegionInline}</dd>
        </div>
      </dl>
    </div>
  </div>
</BaseLayout>

<script>
  /*
   * Post the request without leaving the page, so the design's inline
   * thank-you can be shown. If the post fails the form comes back with a note
   * pointing at the phone number, because a silently swallowed enquiry is a
   * lost job.
   *
   * A caveat worth knowing before you trust the green tick: a plain static host
   * will happily answer 200 to a POST at a path it serves, whether or not
   * anything collected the body. On Netlify the form is picked up from
   * `data-netlify` and a 200 means accepted, but deployed anywhere else with
   * PUBLIC_CONTACT_ENDPOINT unset, this panel can report success while the
   * enquiry goes nowhere. No client-side check can tell those apart, which is
   * why the README asks for one real submission to be confirmed by hand.
   */
  const form = document.querySelector<HTMLFormElement>('[data-consult-form]');
  const sent = document.querySelector<HTMLElement>('[data-consult-sent]');
  const failed = document.querySelector<HTMLElement>('[data-consult-failed]');
  const nameOut = document.querySelector<HTMLElement>('[data-consult-name]');
  const again = document.querySelector<HTMLButtonElement>('[data-consult-again]');

  if (form && sent && failed && nameOut && again) {
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      failed.hidden = true;
      submit.disabled = true;
      submit.textContent = 'Sending';

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
        if (!response.ok) throw new Error(String(response.status));

        nameOut.textContent = String(data.get('name') || '').trim() || 'there';
        form.hidden = true;
        sent.hidden = false;
        sent.focus();
      } catch {
        failed.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = 'Request a consultation';
      }
    });

    again.addEventListener('click', () => {
      form.reset();
      sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
    });
  }
</script>

<style>
  .contact {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 2.75rem var(--gutter) 0;
    display: flex;
    gap: var(--space-2xl);
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .contact__main {
    flex: 999 1 460px;
    min-width: 290px;
  }

  .contact__title {
    max-width: 20ch;
  }

  .contact__phone {
    display: inline-block;
    margin-block-start: 1.25rem;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    text-decoration: none;
    border-block-end: 4px solid var(--color-highlight);
    padding-block-end: 0.25rem;
  }

  .contact__alt {
    margin-block-start: 1rem;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .contact__alt a {
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    border-block-end: 2px solid var(--color-highlight);
  }

  .contact__note {
    margin-block-start: 1.375rem;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
    max-width: 52ch;
  }

  .contact__side {
    flex: 1 1 280px;
    min-width: 260px;
  }

  /* ---- Form ------------------------------------------------------------ */

  .form {
    margin-block-start: 2rem;
    max-width: 520px;
  }

  .form__fields {
    border-block-start: var(--rule-structure) solid var(--color-structure);
    padding-block-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }

  .field__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gmz-teal);
  }

  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: var(--text-base);
    padding: 0.875rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg);
    color: var(--color-text);
    width: 100%;
  }

  .field textarea {
    resize: vertical;
  }

  .form__submit {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 1rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border: none;
    cursor: pointer;
    transition:
      background var(--transition),
      color var(--transition);
  }

  .form__submit:hover:not(:disabled) {
    background: var(--color-highlight);
    color: var(--gmz-teal);
  }

  .form__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  /* ---- States ---------------------------------------------------------- */

  .sent {
    margin-block-start: 2rem;
    max-width: 520px;
    border-block-start: var(--rule-structure) solid var(--color-structure);
    padding-block-start: 1.5rem;
    animation: gmzRise 400ms var(--ease) both;
  }

  .sent__title {
    margin-block-start: 0.625rem;
    font-size: 1.6875rem;
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    color: var(--color-text);
    line-height: 1.3;
  }

  .sent__note {
    margin-block-start: 0.75rem;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .sent__again {
    margin-block-start: 1.25rem;
    font-size: var(--text-sm);
  }

  .failed {
    margin-block-start: 1.125rem;
    max-width: 520px;
    font-size: var(--text-base);
    color: var(--color-text);
    border-inline-start: var(--rule-accent) solid var(--color-highlight);
    padding-inline-start: 0.875rem;
  }

  @media (prefers-color-scheme: dark) {
    .field__label {
      color: var(--color-text);
    }
  }
</style>
