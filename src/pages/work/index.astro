---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import { getProjects, getDisciplineFacets, DISCIPLINE_LABELS, labelFor } from '@data/content';

const projects = await getProjects();
const facets = await getDisciplineFacets();
---

<BaseLayout
  title="Work"
  description="Landscape design, hardscape, planting and maintenance projects across the San Francisco Peninsula."
>
  <PageHeader
    eyebrow="Portfolio"
    title="Our work"
    lede="Projects across the Peninsula, from full property builds to standing maintenance accounts."
  />

  <div class="section">
    <div class="container">
      {
        /*
         * Filtering is client-side and progressive: with JavaScript off, the
         * chips are plain links to the anchor and every project stays
         * visible. The finished design can replace the chrome without
         * touching the data attributes this depends on.
         */
      }
      {
        facets.length > 1 && (
          <div class="filters" data-filters>
            <span class="filters__label" id="filter-label">
              Filter by trade
            </span>
            <ul class="filters__list" aria-labelledby="filter-label">
              <li>
                <button type="button" data-filter="all" aria-pressed="true">
                  All <span class="filters__count">{projects.length}</span>
                </button>
              </li>
              {facets.map(({ value, count }) => (
                <li>
                  <button type="button" data-filter={value} aria-pressed="false">
                    {labelFor(DISCIPLINE_LABELS, value)} <span class="filters__count">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div data-project-list>
        <ProjectGrid {projects} emptyMessage="No projects match that filter." />
      </div>

      <p class="status" role="status" data-filter-status></p>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-project-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (root && list) {
    // Each card carries its disciplines in a data attribute, so the filter
    // reads slugs rather than parsing display labels back out of the markup.
    const items = [...list.querySelectorAll<HTMLElement>('li')];
    const disciplinesOf = (item: HTMLElement) =>
      (item.querySelector<HTMLElement>('[data-disciplines]')?.dataset.disciplines ?? '').split(' ');

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;

      const filter = button.dataset.filter ?? 'all';

      for (const other of root.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
        other.setAttribute('aria-pressed', String(other === button));
      }

      let shown = 0;
      for (const item of items) {
        const match = filter === 'all' || disciplinesOf(item).includes(filter);
        item.hidden = !match;
        if (match) shown += 1;
      }

      if (status) {
        status.textContent =
          filter === 'all'
            ? `Showing all ${shown} projects.`
            : `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}.`;
      }
    });
  }
</script>

<style>
  .filters {
    margin-block-end: var(--space-xl);
  }

  .filters__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: var(--space-sm);
  }

  .filters__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .filters__list button {
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background var(--transition),
      border-color var(--transition);
  }

  .filters__list button:hover {
    border-color: var(--color-accent);
  }

  .filters__list button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .filters__count {
    opacity: 0.65;
    font-size: var(--text-xs);
  }

  .status {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
