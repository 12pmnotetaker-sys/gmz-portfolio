---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import Testimonial from '@components/Testimonial.astro';
import {
  getProjects,
  getProjectTestimonial,
  getRelatedProjects,
  DISCIPLINE_LABELS,
  SERVICE_LINE_LABELS,
  labelFor,
  type Project,
} from '@data/content';
import { primaryPhone } from '@data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const {
  title,
  summary,
  location,
  completed,
  serviceLine,
  disciplines,
  hero,
  gallery,
  duration,
  budgetBand,
  showBudgetBand,
  seo,
} = project.data;

const { Content } = await render(project);
const testimonial = await getProjectTestimonial(project);
const related = await getRelatedProjects(project);

const completedLabel = completed.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

/**
 * Facts panel. budgetBand appears only when the entry explicitly opts in;
 * cost, margin and crew-day figures never appear here at all.
 */
const facts = [
  { label: 'Location', value: location },
  { label: 'Completed', value: completedLabel },
  { label: 'Service line', value: labelFor(SERVICE_LINE_LABELS, serviceLine) },
  { label: 'Scope', value: disciplines.map((d) => labelFor(DISCIPLINE_LABELS, d)).join(', ') },
  ...(duration ? [{ label: 'Duration', value: duration }] : []),
  ...(showBudgetBand && budgetBand ? [{ label: 'Budget range', value: budgetBand }] : []),
];
---

<BaseLayout
  title={seo.title ?? title}
  description={seo.description ?? summary}
  noindex={seo.noindex}
  type="article"
>
  <article>
    <div class="hero">
      <div class="container">
        <p class="hero__eyebrow">{labelFor(SERVICE_LINE_LABELS, serviceLine)}</p>
        <h1>{title}</h1>
        <p class="hero__summary">{summary}</p>
      </div>
    </div>

    <div class="container">
      <Image
        class="hero__image"
        src={hero.src}
        alt={hero.alt}
        width={1600}
        height={1067}
        widths={[600, 1000, 1600]}
        sizes="(min-width: 68rem) 68rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
      {hero.caption && <p class="caption">{hero.caption}</p>}
    </div>

    <div class="container layout">
      <div class="prose">
        <Content />
      </div>

      <aside class="facts" aria-label="Project details">
        <dl>
          {
            facts.map((fact) => (
              <div class="facts__row">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="facts__cta">
          <a href="/contact">Start a project like this</a>
          <span class="facts__phone">
            or call <a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
          </span>
        </p>
      </aside>
    </div>

    {
      gallery.length > 0 && (
        <section class="section" aria-labelledby="gallery-heading">
          <div class="container">
            <h2 id="gallery-heading" class="visually-hidden">
              Project photographs
            </h2>
            <ul class="gallery">
              {gallery.map((photo) => (
                <li>
                  <figure>
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      width={1000}
                      height={667}
                      widths={[500, 1000]}
                      sizes="(min-width: 50rem) 50vw, 100vw"
                      loading="lazy"
                    />
                    {(photo.caption || photo.phase) && (
                      <figcaption class="caption">
                        {photo.phase && <span class="phase">{photo.phase}</span>}
                        {photo.caption}
                      </figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      testimonial && (
        <section class="section" aria-labelledby="quote-heading">
          <div class="container">
            <h2 id="quote-heading" class="visually-hidden">
              What the client said
            </h2>
            <Testimonial {testimonial} />
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="section section--tint" aria-labelledby="related-heading">
          <div class="container">
            <h2 id="related-heading">Related work</h2>
            <div class="related">
              <ProjectGrid projects={related} />
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .hero__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-block-end: var(--space-xs);
  }

  .hero__summary {
    max-width: var(--width-prose);
    margin-block-start: var(--space-md);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__image {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-lg);
  }

  .caption {
    margin-block-start: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .phase {
    display: inline-block;
    margin-inline-end: var(--space-xs);
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--color-bg-tint);
    color: var(--color-accent-hover);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .layout {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .facts {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
    font-size: var(--text-sm);
  }

  .facts dl {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }

  .facts__row dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .facts__row dd {
    margin: 0;
    margin-block-start: var(--space-2xs);
  }

  .facts__cta {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--color-border);
    font-weight: 600;
  }

  .facts__phone {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .gallery {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(24rem, 100%), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery :global(img) {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-md);
  }

  .section--tint {
    background: var(--color-bg-subtle);
  }

  .related {
    margin-block-start: var(--space-lg);
  }
</style>
