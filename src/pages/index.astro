---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import Testimonial from '@components/Testimonial.astro';
import heroImage from '@/assets/hero/placeholder-hero.jpg';
import { getFeaturedProjects, getServices, getFeaturedTestimonials } from '@data/content';
import { company, primaryPhone } from '@data/site';

/*
 * The hero photograph, and the alt text that describes it.
 *
 * These two belong together: when the real photograph replaces
 * placeholder-hero.jpg, this string has to be rewritten to describe what is
 * actually in the frame. Leaving it saying "bands of green" over a picture of
 * a finished courtyard is worse than having no alt at all.
 */
const heroAlt =
  'Bands of deep green marking a change of grade, standing in until project photography lands.';

const projects = await getFeaturedProjects(3);
const services = await getServices();
const testimonials = await getFeaturedTestimonials(2);

/*
 * The tagline is three words, so the capability strip is three columns.
 * The content only knows two service lines, because that is how the work is
 * sold and quoted. Design is the planning step that opens the design-build
 * line; everything else in that line is the building.
 */
const DESIGN_ID = 'landscape-design';
const designBuild = services.filter((s) => s.data.serviceLine === 'design-build');

const capabilities = [
  {
    name: 'Design',
    lede: 'A measured plan before anything is built, because it is cheaper to move a line on paper than a wall in the ground.',
    items: designBuild.filter((s) => s.id === DESIGN_ID),
  },
  {
    name: 'Build',
    lede: 'The structural half. Bases, footings and drainage sized for the soil and the load rather than for the schedule.',
    items: designBuild.filter((s) => s.id !== DESIGN_ID),
  },
  {
    name: 'Maintenance',
    lede: 'A standing obligation rather than a project with an end date, on its own agreement and its own fixed schedule.',
    items: services.filter((s) => s.data.serviceLine === 'maintenance'),
  },
].filter((c) => c.items.length > 0);

/* Services that make a below-grade argument. The claim lives with the
   service; the homepage only arranges them. */
const structural = services.filter((s) => s.data.pullQuote);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__media">
      <Image
        class="hero__image"
        src={heroImage}
        alt={heroAlt}
        widths={[900, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="container hero__overlay">
        <p class="label">{company.tagline}</p>
        <h1 class="hero__title">Everything that lasts starts <em>below</em> the surface.</h1>
        <p class="hero__actions">
          <a class="button" href="/contact">Start a project</a>
          <a class="button button--quiet" href="/work">See the work</a>
        </p>
      </div>
    </div>

    <div class="container hero__meta">
      <div class="surveyline" aria-hidden="true"></div>
      <dl class="stats">
        <div>
          <dt>License</dt>
          <dd>{company.license.display}</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{company.address.locality}</dd>
        </div>
        <div>
          <dt>Working across</dt>
          <dd>The San Francisco Peninsula</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="cap" aria-labelledby="cap-heading">
    <h2 id="cap-heading" class="visually-hidden">What we do</h2>
    <div class="cap__grid">
      {
        capabilities.map((col) => (
          <div class="cap__col">
            <h3>{col.name}</h3>
            <p class="cap__lede">{col.lede}</p>
            <ul class="cap__list">
              {col.items.map((service) => (
                <li>
                  <a href={`/services/${service.id}`}>{service.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="work-heading">Recent work</h2>
        <a href="/work">All projects</a>
      </div>
      <ProjectGrid {projects} emptyMessage="Project photography is on its way." />
    </div>
  </section>

  {
    structural.length > 0 && (
      <section class="section below" aria-labelledby="below-heading">
        <div class="container below__grid">
          <div>
            <p class="label">Why it holds</p>
            <h2 id="below-heading">The part you never see</h2>
          </div>
          <div class="facts">
            {structural.map((service) => (
              <article class="fact">
                <h3>
                  <a href={`/services/${service.id}`}>{service.data.pullQuote}</a>
                </h3>
                <p>{service.data.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="band">
    <div class="container band__inner">
      <p class="band__license">{company.license.display}</p>
      <p>{company.address.locality}, {company.address.region}</p>
      <p>Written change orders before any extra work starts</p>
    </div>
  </section>

  <section class="section" aria-labelledby="area-heading">
    <div class="container">
      <p class="label">Service area</p>
      <h2 id="area-heading" class="visually-hidden">Where we work</h2>
      <ul class="towns">
        {company.serviceArea.map((town) => <li>{town}</li>)}
      </ul>
      <p class="towns__note">
        If you are just outside this list, call and ask. The answer depends on the job.
      </p>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section" aria-labelledby="testimonials-heading">
        <div class="container">
          <h2 id="testimonials-heading">What clients say</h2>
          <ul class="quotes">
            {testimonials.map((testimonial) => (
              <li>
                <Testimonial {testimonial} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section cta" aria-labelledby="cta-heading">
    <div class="container">
      <h2 id="cta-heading">Let's walk the site</h2>
      <p class="cta__lede">The first visit is free, and booking it commits you to nothing.</p>
      <p class="cta__actions">
        <a class="button" href={`tel:${primaryPhone.tel}`}>Call {primaryPhone.display}</a>
        <a class="button button--quiet" href="/contact">Send the details</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- shared button ------------------------------------------------- */
  .button {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.62rem 1.5rem 0.5rem;
    border: 2px solid var(--color-accent-solid);
    border-radius: var(--radius-md);
    background: var(--color-accent-solid);
    color: #fff;
    text-decoration: none;
    transition:
      background var(--transition),
      border-color var(--transition),
      color var(--transition);
  }

  .button:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  .button--quiet {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .button--quiet:hover {
    background: transparent;
    border-color: var(--color-text);
    color: var(--color-text);
  }

  /* ---- hero ------------------------------------------------------------ */
  /*
   * Image-led rather than type-led. The photograph is the thing that has to
   * stop someone scrolling, so it runs full bleed and the words sit on it at
   * supporting size instead of filling the screen themselves.
   */
  .hero__media {
    position: relative;
    isolation: isolate;
  }

  .hero__image {
    display: block;
    inline-size: 100%;
    block-size: clamp(24rem, 66vh, 42rem);
    object-fit: cover;
  }

  /*
   * Darkens the foot of the image so the overlay always has a ground to sit
   * on, whatever the photograph turns out to be, and dissolves the bottom
   * edge into the page so there is no hard seam.
   */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-bg) 0%,
      color-mix(in srgb, var(--color-bg) 78%, transparent) 26%,
      transparent 58%
    );
  }

  .hero__overlay {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    padding-block-end: var(--space-xl);
  }

  .hero__title {
    font-size: var(--text-2xl);
    max-width: 22ch;
    margin: 0;
  }

  .hero__title em {
    font-style: normal;
    color: var(--color-accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: 0;
  }

  .hero__meta {
    margin-block-start: var(--space-xl);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg) var(--space-2xl);
    margin: 0;
    padding-block-start: var(--space-md);
  }

  .stats div {
    display: grid;
    gap: var(--space-2xs);
  }

  .stats dt {
    font-size: 0.625rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .stats dd {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  @media (max-width: 54rem) {
    .hero__image {
      block-size: clamp(20rem, 56vh, 28rem);
    }

    .hero__title {
      font-size: var(--text-xl);
    }
  }

  /* ---- capability strip -------------------------------------------------- */
  .cap {
    margin-block-start: var(--space-2xl);
    background: var(--color-bg-subtle);
    border-block: 1px solid var(--color-border);
  }

  .cap__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .cap__col {
    padding: var(--space-xl) var(--gutter);
    border-inline-start: 1px solid var(--color-border);
  }

  .cap__col:first-child {
    border-inline-start: 0;
  }

  .cap__col h3 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    text-transform: uppercase;
    line-height: 1;
  }

  .cap__lede {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-sm) var(--space-lg);
  }

  .cap__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .cap__list a {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .cap__list a::before {
    content: '';
    inline-size: 14px;
    block-size: 1px;
    background: var(--color-accent-solid);
    flex: none;
  }

  .cap__list a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 54rem) {
    .cap__grid {
      grid-template-columns: 1fr;
    }

    .cap__col {
      border-inline-start: 0;
      border-block-start: 1px solid var(--color-border);
    }

    .cap__col:first-child {
      border-block-start: 0;
    }
  }

  /* ---- section furniture --------------------------------------------------- */
  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  .section__head a {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* ---- below the surface ----------------------------------------------------- */
  .below {
    background: var(--color-bg-subtle);
    border-block: 1px solid var(--color-border);
  }

  .below__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
  }

  .below h2 {
    margin-block-start: var(--space-sm);
  }

  .facts {
    display: grid;
    gap: var(--space-lg);
  }

  .fact {
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--space-md);
  }

  .fact h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .fact h3 a:hover {
    color: var(--color-accent);
  }

  .fact p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-block-start: var(--space-xs);
  }

  @media (max-width: 54rem) {
    .below__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- license band ------------------------------------------------------------ */
  /*
   * The deep green, not the solid brand green. The two short lines here run
   * at --text-sm, and white on #008C41 is 4.35:1, which is fine for a large
   * button label but short of the 4.5:1 small text needs. On the deep green
   * it is 7.8:1. The band reads the same; the type is actually legible.
   */
  .band {
    background: var(--gmz-green-deep);
    color: #fff;
  }

  .band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-lg);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .band__license {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  /* ---- towns ---------------------------------------------------------------------- */
  .towns {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
  }

  .towns li {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
  }

  .towns li::after {
    content: '/';
    color: var(--color-accent-solid);
    margin-inline: var(--space-sm);
  }

  .towns li:last-child::after {
    content: '';
  }

  .towns__note {
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
    max-width: var(--width-prose);
  }

  /* ---- quotes and cta -------------------------------------------------------------- */
  .quotes {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
  }

  .cta {
    text-align: center;
  }

  .cta__lede {
    max-width: 46ch;
    margin-inline: auto;
    margin-block-start: var(--space-md);
    color: var(--color-text-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
</style>
