---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectGrid from '@components/ProjectGrid.astro';
import ServiceCard from '@components/ServiceCard.astro';
import Testimonial from '@components/Testimonial.astro';
import { getFeaturedProjects, getFeaturedServices, getFeaturedTestimonials } from '@data/content';
import { company, primaryPhone } from '@data/site';

const projects = await getFeaturedProjects(3);
const services = await getFeaturedServices(4);
const testimonials = await getFeaturedTestimonials(2);
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="hero__eyebrow">{company.tagline}</p>
      <h1 class="hero__title">Outdoor spaces built to last on the Peninsula.</h1>
      <p class="hero__lede">{company.summary}</p>
      <p class="hero__actions">
        <a class="button" href="/contact">Start a project</a>
        <a class="button button--quiet" href="/work">See our work</a>
      </p>
      <p class="hero__license">{company.license.display}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="work-heading">Recent work</h2>
        <a href="/work">All projects</a>
      </div>
      <ProjectGrid {projects} emptyMessage="Project photography is on its way." />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="services-heading">
    <div class="container">
      <div class="section__head">
        <h2 id="services-heading">What we do</h2>
        <a href="/services">All services</a>
      </div>
      <ul class="services">
        {
          services.map((service) => (
            <li>
              <ServiceCard {service} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section" aria-labelledby="testimonials-heading">
        <div class="container">
          <h2 id="testimonials-heading">What clients say</h2>
          <ul class="quotes">
            {testimonials.map((testimonial) => (
              <li>
                <Testimonial {testimonial} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section cta" aria-labelledby="cta-heading">
    <div class="container">
      <h2 id="cta-heading">Thinking about a project?</h2>
      <p>
        Tell us what you have in mind and we will come look at the site. Call
        <a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a> or
        <a href="/contact">send us the details</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl);
    background: var(--color-bg-subtle);
    border-block-end: 1px solid var(--color-border);
  }

  .hero__eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    max-width: 18ch;
    margin-block-start: var(--space-sm);
    font-size: var(--text-4xl);
  }

  .hero__lede {
    max-width: var(--width-prose);
    margin-block-start: var(--space-md);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xl);
  }

  .hero__license {
    margin-block-start: var(--space-lg);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .button {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition);
  }

  .button:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-contrast);
  }

  .button--quiet {
    background: transparent;
    color: var(--color-accent);
  }

  .button--quiet:hover {
    background: var(--color-bg-tint);
    color: var(--color-accent-hover);
  }

  .section--tint {
    background: var(--color-bg-subtle);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  .section__head a {
    font-size: var(--text-sm);
  }

  .services,
  .quotes {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quotes {
    margin-block-start: var(--space-lg);
  }

  .cta {
    text-align: center;
  }

  .cta p {
    max-width: var(--width-prose);
    margin-inline: auto;
    margin-block-start: var(--space-md);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
