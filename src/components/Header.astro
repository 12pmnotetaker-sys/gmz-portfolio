---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/gmz-logo-knockout.png';
import { company, primaryNav, primaryPhone } from '@data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const isHome = path === '/';
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/" aria-current={isHome ? 'page' : undefined}>
      {
        /*
        Decorative: the company name follows as real text, so giving the mark
        an alt would make a screen reader announce "GMZ Landscaping" twice.
        The attribute is present and deliberately empty, not dropped.
      */
      }
      <Image class="header__mark" src={logo} alt="" width={72} densities={[1, 2]} />
      <span class="header__name">
        {company.name}
        <span class="header__tagline">{company.tagline}</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header__phone" href={`tel:${primaryPhone.tel}`}>
      <span class="visually-hidden">Call {company.name} at </span>
      {primaryPhone.display}
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-sm);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .header__mark {
    inline-size: 34px;
    block-size: auto;
  }

  .header__name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .header__tagline {
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /*
   * The nav wraps onto its own line on narrow screens rather than collapsing
   * into a drawer. Same call the scaffold made: no JS to unpick, and nobody
   * loses navigation on a phone.
   */
  .header__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .header__list a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .header__list a:hover,
  .header__list a[aria-current='page'] {
    color: var(--color-accent);
  }

  .header__list a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.45em;
    text-decoration-thickness: 2px;
  }

  .header__phone {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    background: var(--color-accent-solid);
    color: #fff;
    padding: 0.3rem 1rem 0.2rem;
    border-radius: var(--radius-md);
    transition: background var(--transition);
  }

  .header__phone:hover {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  @media (max-width: 60rem) {
    .header__brand {
      margin-inline-end: 0;
    }

    .header__nav {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
