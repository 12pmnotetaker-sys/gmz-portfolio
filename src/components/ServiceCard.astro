---
import { SERVICE_LINE_LABELS, labelFor, type Service } from '@data/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { title, summary, highlights, serviceLine } = service.data;
---

<article class="service">
  <p class="service__line">{labelFor(SERVICE_LINE_LABELS, serviceLine)}</p>
  <h3 class="service__title">
    <a href={`/services/${service.id}`}>{title}</a>
  </h3>
  <p class="service__summary">{summary}</p>
  {
    highlights.length > 0 && (
      <ul class="service__highlights">
        {highlights.slice(0, 3).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .service {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    block-size: 100%;
  }

  .service__line {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .service__title a {
    color: inherit;
    text-decoration: none;
  }

  .service__title a:hover {
    color: var(--color-accent);
  }

  .service__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .service__highlights {
    font-size: var(--text-sm);
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }
</style>
