---
import { Image } from 'astro:assets';
import { company } from '@data/site';
import logo from '@/assets/brand/gmz-logo.png';

interface Props {
  /**
   * Rendered height in px. The mark is portrait (627 x 850), so the width
   * follows from it; never set both.
   */
  height: number;
  class?: string;
}

const { height, class: className } = Astro.props;

/**
 * The GMZ mark.
 *
 * White artwork on transparent, so it is only legible on the teal chrome. Every
 * place the design uses it (masthead, drawer, footer, veil) is teal. Do not put
 * it on a light ground without a dark plate behind it.
 *
 * The source has been trimmed of its transparent margin, which the original
 * carried. The design's heights were set against the untrimmed file, so they
 * are scaled by 0.787 here to keep the mark the same optical size it was drawn
 * at rather than 27% larger.
 */
const RATIO = 627 / 850;
const width = Math.round(height * RATIO);
---

<Image
  src={logo}
  alt={company.name}
  width={width}
  height={height}
  densities={[1, 2]}
  class={className}
/>
