---
import { Image } from 'astro:assets';
import { company, gate, hoursInline, licenseShort, primaryPhone, secondaryPhone } from '@data/site';
import logo from '@/assets/brand/gmz-logo.svg';
import apld from '@/assets/brand/apld-logo.webp';

/**
 * The footer: the closing invitation, the marks, and the contact strip.
 *
 * Every fact in the strip is read from src/data/site.ts. Do not retype one
 * here, even once: that is the mistake the estimating system paid for.
 */
const membership = company.memberships[0];
---

<footer class="footer on-dark">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__pitch">
        <p class="footer__lede">Ready to talk about your own yard?</p>
        <p class="footer__note">
          We'll walk the property with you, listen to what you want from it, and tell you honestly
          what it will take.
        </p>
        <a class="btn btn--amber footer__cta" href="/contact">
          Schedule your complimentary consultation
        </a>
      </div>

      <div class="footer__marks">
        <img class="footer__logo" src={logo.src} alt={company.name} width="300" height="96" />
        {
          membership && (
            <div class="footer__apld">
              <Image src={apld} alt={membership.name} widths={[240, 480]} sizes="240px" />
            </div>
          )
        }
      </div>
    </div>

    <div class="footer__divider"></div>

    <div class="footer__strip">
      <a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a>
      <a href={`tel:${secondaryPhone.tel}`}>{secondaryPhone.display}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <span>{hoursInline}</span>
      <span>{company.address.mailing}</span>
      <span>{licenseShort}</span>
      {
        gate.enabled && (
          <button type="button" class="footer__lock" data-gate-lock>
            Lock portfolio
          </button>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--gmz-teal);
    padding: 3.25rem var(--gutter) 2.5rem;
    margin-block-start: var(--space-3xl);
  }

  .footer__inner {
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .footer__pitch {
    flex: 1 1 380px;
  }

  .footer__lede {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.3;
    color: #fff;
    font-weight: 600;
    max-width: 24ch;
  }

  .footer__note {
    margin-block-start: 0.8125rem;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: #fff;
    opacity: 0.9;
    max-width: 40ch;
  }

  .footer__cta {
    margin-block-start: 1.375rem;
  }

  .footer__marks {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-end;
    flex: none;
  }

  .footer__logo {
    height: 88px;
    width: auto;
  }

  /* The APLD mark is dark artwork, so it needs a white ground on the teal. */
  .footer__apld {
    background: #fff;
    padding: 0.75rem 1rem;
  }

  .footer__apld :global(img) {
    height: 46px;
    width: auto;
  }

  .footer__divider {
    height: 1px;
    background: rgb(255 255 255 / 30%);
    margin: 2.25rem 0 1.125rem;
  }

  .footer__strip {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    font-size: 1rem;
    color: #fff;
    opacity: 0.94;
    align-items: center;
  }

  .footer__strip a {
    color: #fff;
    text-decoration: none;
  }

  .footer__strip a:hover {
    color: var(--gmz-amber);
  }

  .footer__lock {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gmz-amber);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  @media (width < 760px) {
    .footer__marks {
      align-items: flex-start;
    }
  }
</style>
