---
import { company, primaryNav, primaryPhone } from '@data/site';

const year = new Date().getFullYear();
const social = Object.entries(company.social).filter(([, href]) => href);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__block">
      <p class="footer__name">{company.legalName}</p>
      <p class="footer__tagline">{company.tagline}</p>
      <p class="footer__license">{company.license.display}</p>
    </div>

    <div class="footer__block">
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        {
          /*
           * The footer carries the company, not a person: only the first
           * listed number appears here. The full list lives on /contact.
           */
        }
        <li><a href={`tel:${primaryPhone.tel}`}>{primaryPhone.display}</a></li>
        <li>{company.address.mailing}</li>
      </ul>
    </div>

    <div class="footer__block">
      <h2 class="footer__heading">Site</h2>
      <ul class="footer__list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      social.length > 0 && (
        <div class="footer__block">
          <h2 class="footer__heading">Follow</h2>
          <ul class="footer__list">
            {social.map(([name, href]) => (
              <li>
                <a href={href} rel="me noopener">
                  {name.charAt(0).toUpperCase() + name.slice(1)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="container footer__legal">
    <p>&copy; {year} {company.legalName}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-3xl);
    padding-block: var(--space-2xl) var(--space-lg);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .footer__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .footer__tagline,
  .footer__license {
    font-size: var(--text-sm);
    opacity: 0.82;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.72;
    margin-block-end: var(--space-sm);
  }

  .footer__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: inherit;
    text-decoration: underline;
  }

  .footer :global(:focus-visible) {
    outline-color: var(--color-text-inverse);
  }

  .footer__legal {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid rgb(255 255 255 / 18%);
    font-size: var(--text-xs);
    opacity: 0.72;
  }
</style>
