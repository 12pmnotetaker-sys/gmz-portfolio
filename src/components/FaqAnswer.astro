---
import { FAQ_PHASE_LABELS, labelFor, type Faq } from '@data/content';

interface Props {
  faq: Faq;
  /** Plain-text answer, lowercased into the client-side search index. */
  searchText?: string;
  /** Hide the stage tag where the surrounding section already says it. */
  showPhase?: boolean;
  /** Quieter presentation, for secondary listings. */
  quiet?: boolean;
}

const { faq, searchText = '', showPhase = true, quiet = false } = Astro.props;
const { question, phase, needsDecision, decisionNote } = faq.data;

const index = `${question} ${searchText} ${labelFor(FAQ_PHASE_LABELS, phase)}`
  .replace(/\s+/g, ' ')
  .trim()
  .toLowerCase();
---

<div
  class:list={['item', quiet && 'item--quiet']}
  id={faq.id}
  data-faq-item
  data-phase={phase}
  data-search={index}
>
  <details>
    <summary>
      <span class="item__q">{question}</span>
      {
        showPhase && (
          <span class="item__tags">
            <span class="tag">{labelFor(FAQ_PHASE_LABELS, phase)}</span>
            {needsDecision && <span class="tag tag--draft">draft</span>}
          </span>
        )
      }
    </summary>

    <div class="item__a">
      <slot />

      {
        /*
         * Only ever reachable in `npm run dev`: an entry carrying a decision
         * note has published:false, so production never renders it at all.
         * Shown here so the list of what is owed stays in front of you.
         */
        needsDecision && decisionNote && (
          <div class="pending">
            <span class="pending__tag">Not published: needs your sign-off</span>
            <p>{decisionNote}</p>
          </div>
        )
      }
    </div>
  </details>
</div>

<style>
  .item {
    border-block-end: 1px solid var(--color-border);
  }

  .item[hidden] {
    display: none;
  }

  .item summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
    padding-block: var(--space-md);
    cursor: pointer;
    list-style: none;
  }

  .item summary::-webkit-details-marker {
    display: none;
  }

  .item__q {
    flex: 1 1 18rem;
    font-weight: 600;
  }

  .item summary:hover .item__q {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .item details[open] .item__q,
  .item[open] .item__q {
    color: var(--color-accent-hover);
  }

  .item--quiet .item__q {
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .item__tags {
    display: flex;
    gap: var(--space-2xs);
    flex: none;
  }

  .tag {
    padding: 0.15em 0.5em;
    border-radius: 2px;
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tag--draft {
    background: var(--color-bg-tint);
    color: var(--color-accent-hover);
  }

  .item__a {
    padding-block-end: var(--space-lg);
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .item__a :global(p) {
    font-size: var(--text-base);
  }

  .pending {
    padding: var(--space-sm) var(--space-md);
    border-inline-start: 3px solid var(--color-accent);
    background: var(--color-bg-tint);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .pending__tag {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-hover);
    margin-block-end: var(--space-2xs);
  }

  .pending p {
    font-size: var(--text-sm);
    color: var(--color-text);
  }
</style>
