# Copy to .env for local development. .env is gitignored.

# Production origin. Used for canonical URLs and Open Graph tags. Defaults to
# https://www.gmzlandscape.com when unset. There is no sitemap: the
# portfolio is private. See the "Private portfolio" section of README.md.
SITE_URL=https://www.gmzlandscape.com

# Contact form handler. Leave this unset on Netlify: the form carries
# data-netlify and Netlify Forms collects it without an endpoint. Set it to
# post somewhere else instead (Formspree, a Worker). Either way, send a real
# submission and confirm it arrives before shipping.
# PUBLIC_CONTACT_ENDPOINT=
