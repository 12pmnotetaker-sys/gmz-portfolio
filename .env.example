# Copy to .env for local development. .env is gitignored.

# Production origin. Used for canonical URLs, the sitemap and Open Graph tags.
# Defaults to https://www.gmzlandscaping.com when unset.
SITE_URL=https://www.gmzlandscaping.com

# Contact form handler. While this is unset, /contact renders the phone
# numbers and email address and no form at all, so a lead can never be
# silently dropped. Set it to a form endpoint (Formspree, Netlify Forms, a
# Worker) and test that a submission actually arrives before shipping.
# PUBLIC_CONTACT_ENDPOINT=
